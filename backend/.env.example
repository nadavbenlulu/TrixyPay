PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/trixpay?retryWrites=true&w=majority
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
BANK_DETAILS_ENCRYPTION_KEY=replace-with-64-hex-characters
CORS_ORIGINS=http://localhost:8081
COOKIE_SAME_SITE=lax

# Generate BANK_DETAILS_ENCRYPTION_KEY with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep the key stable and backed up; encrypted bank details cannot be recovered without it.
